# ===== VerifyOS 环境变量样例 =====
# 快捷方式：bash scripts/setup-llm.sh （交互式生成 .env，只需选提供商 + 粘 Key）
# 手动方式：cp .env.example .env 后修改
# ⚠️ 安全约定：真实密钥只存在本地 .env（已被 .gitignore 忽略），任何真实 Key 都不要提交进仓库

# --- LLM Gateway（OpenAI 兼容，GLM/DeepSeek 可切） ---
# 智谱 Key 申请：https://bigmodel.cn → 控制台 → API Keys
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
# ← 必填：把你的 Key 粘到上一行
LLM_MODEL=glm-4.6
# 视觉/截图理解任务可切：
# LLM_MODEL=glm-4.5v
# DeepSeek（Key 申请：https://platform.deepseek.com）：
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# 其他 OpenAI 兼容端点（vLLM/Ollama/OneAPI…）：改 LLM_BASE_URL + LLM_MODEL 即可

# --- Langfuse（可观测，可关） ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100

# --- 存储（compose 本地默认值；生产环境请改强密码） ---
DATABASE_URL=postgresql://verifyos:verifyos@127.0.0.1:5433/verifyos
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=verifyos-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- 服务 ---
API_PORT=8080
WEB_PORT=5173
# ⚠️ 生产环境必须更换
JWT_SECRET=dev-secret-change-me

# --- 凭据加密（必填；一次性生成，⚠️ 更换将导致历史已存凭据无法解密） ---
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
